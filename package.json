{
  "name": "epizod",
  "version": "0.0.0",
  "description": "Dynamic, portable, Zod-compatible validation schemas: convert Zod schemas to JSON definitions and rebuild them anywhere.",
  "keywords": [
    "zod",
    "schema",
    "validation",
    "json",
    "serialization",
    "dynamic-forms",
    "json-schema",
    "typescript"
  ],
  "author": "domutala",
  "license": "MIT",
  "homepage": "https://github.com/domutala/epizod#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/domutala/epizod.git"
  },
  "bugs": {
    "url": "https://github.com/domutala/epizod/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "dev": "tsx watch ./playground/index.ts",
    "build": "tsdown",
    "clean": "rm -rf dist",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run typecheck && pnpm run test && pnpm run build",
    "changeset": "changeset",
    "changelog": "@changesets/cli/changelog",
    "version-packages": "changeset version",
    "release": "changeset publish"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0",
  "peerDependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@changesets/changelog-github": "^1.0.1",
    "@changesets/cli": "^3.0.3",
    "@types/node": "^26.6.5",
    "tsdown": "^0.23.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "unrun": "^0.3.1",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
